<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI News Radio DJ</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#3b82f6',
                        dark: '#1a1a1a',
                        darker: '#121212'
                    }
                }
            }
        }
    </script>
    <style>
        body { transition: background-color 0.3s, color 0.3s; }
        .dj-visual {
            transition: transform 0.2s;
        }
        .speaking .dj-visual {
            animation: pulse 1s infinite;
        }
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #888; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #555; }
    </style>
</head>
<body class="bg-gray-100 text-gray-800 dark:bg-darker dark:text-gray-200 min-h-screen flex flex-col items-center justify-center p-4">

    <!-- Settings Modal -->
    <div id="settingsModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-white dark:bg-dark rounded-2xl shadow-2xl w-full max-w-md p-6 transform transition-all">
            <h2 class="text-2xl font-bold mb-6 text-center">ラジオ設定</h2>
            
            <!-- Theme Selection -->
            <div class="mb-6">
                <label class="block text-sm font-medium mb-2">テーマ</label>
                <div class="grid grid-cols-3 gap-2">
                    <button onclick="setTheme('light')" class="p-2 rounded border border-gray-300 hover:bg-gray-100 dark:border-gray-600 dark:hover:bg-gray-700">
                        <i class="fas fa-sun mb-1"></i><br>ライト
                    </button>
                    <button onclick="setTheme('dark')" class="p-2 rounded border border-gray-300 hover:bg-gray-100 dark:border-gray-600 dark:hover:bg-gray-700">
                        <i class="fas fa-moon mb-1"></i><br>ダーク
                    </button>
                    <button onclick="setTheme('system')" class="p-2 rounded border border-gray-300 hover:bg-gray-100 dark:border-gray-600 dark:hover:bg-gray-700">
                        <i class="fas fa-desktop mb-1"></i><br>系統
                    </button>
                </div>
            </div>

            <!-- Voice Settings -->
            <div class="mb-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-2">性別</label>
                    <select id="voiceGender" class="w-full p-2 rounded border dark:bg-gray-800 dark:border-gray-700">
                        <option value="female">女性</option>
                        <option value="male">男性</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">年齢層 (推定)</label>
                    <select id="voiceAge" class="w-full p-2 rounded border dark:bg-gray-800 dark:border-gray-700">
                        <option value="10">10代 (若々しい)</option>
                        <option value="20">20代</option>
                        <option value="30">30代</option>
                        <option value="40">40代</option>
                        <option value="50">50代</option>
                        <option value="60">60代 (落ち着いた)</option>
                    </select>
                </div>
            </div>

            <!-- News Category -->
            <div class="mb-8">
                <label class="block text-sm font-medium mb-2">ニュースチャンネル</label>
                <select id="newsCategory" class="w-full p-2 rounded border dark:bg-gray-800 dark:border-gray-700">
                    <option value="general">総合 (General)</option>
                    <option value="business">ビジネス・経済</option>
                    <option value="technology">テクノロジー</option>
                    <option value="entertainment">エンタメ</option>
                    <option value="sports">スポーツ</option>
                    <option value="science">サイエンス</option>
                    <option value="health">ヘルス</option>
                </select>
            </div>

            <button onclick="saveSettings()" class="w-full bg-primary hover:bg-blue-600 text-white font-bold py-3 rounded-lg transition">
                設定を保存して開始
            </button>
        </div>
    </div>

    <!-- Main App Container -->
    <div class="w-full max-w-4xl bg-white dark:bg-dark rounded-3xl shadow-xl overflow-hidden flex flex-col md:flex-row min-h-[600px]">
        
        <!-- Left: DJ Visual & Controls -->
        <div class="w-full md:w-1/3 bg-gray-50 dark:bg-gray-900 p-6 flex flex-col items-center border-r dark:border-gray-800 relative">
            <!-- DJ Avatar -->
            <div class="dj-visual w-32 h-32 rounded-full bg-gradient-to-br from-blue-400 to-purple-500 flex items-center justify-center text-5xl text-white shadow-lg mb-6 mt-4">
                <i class="fas fa-microphone-alt"></i>
            </div>
            
            <h1 class="text-xl font-bold mb-1">News DJ</h1>
            <p id="currentCategoryDisplay" class="text-sm text-gray-500 dark:text-gray-400 mb-6">総合ニュース</p>

            <!-- Controls -->
            <div class="flex space-x-4 mb-8">
                <button id="playBtn" onclick="togglePlay()" class="w-14 h-14 rounded-full bg-primary text-white flex items-center justify-center shadow-lg hover:scale-105 transition">
                    <i class="fas fa-play ml-1"></i>
                </button>
                <button onclick="openSettings()" class="w-14 h-14 rounded-full bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 flex items-center justify-center hover:bg-gray-300 dark:hover:bg-gray-600 transition">
                    <i class="fas fa-cog"></i>
                </button>
            </div>

            <!-- Status -->
            <div class="mt-auto w-full">
                <div class="bg-gray-200 dark:bg-gray-800 rounded-full h-2 mb-2 overflow-hidden">
                    <div id="progressBar" class="bg-primary h-full w-0 transition-all duration-300"></div>
                </div>
                <div class="flex justify-between text-xs text-gray-500">
                    <span id="statusText">待機中</span>
                    <span id="timer">00:00</span>
                </div>
            </div>
        </div>

        <!-- Right: Content & Transcript -->
        <div class="w-full md:w-2/3 p-6 md:p-8 flex flex-col">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-bold flex items-center">
                    <i class="fas fa-newspaper mr-2 text-primary"></i> ライブフィード
                </h2>
                <button onclick="refreshNews()" class="text-sm text-primary hover:underline">
                    <i class="fas fa-sync-alt"></i> 更新
                </button>
            </div>

            <!-- Transcript Area -->
            <div id="transcriptArea" class="flex-1 overflow-y-auto space-y-4 pr-2 mb-4 font-medium leading-relaxed text-gray-700 dark:text-gray-300">
                <div class="text-center text-gray-400 mt-10">
                    <i class="fas fa-volume-up text-4xl mb-3 opacity-50"></i>
                    <p>再生ボタンを押すと、<br>最新のニュースを読み上げます。</p>
                </div>
            </div>

            <!-- Current Headline -->
            <div class="bg-blue-50 dark:bg-blue-900/20 p-4 rounded-xl border-l-4 border-primary">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">NOW PLAYING</p>
                <p id="currentHeadline" class="font-bold text-gray-800 dark:text-gray-100 truncate">-</p>
            </div>
        </div>
    </div>

    <script>
        // --- Configuration ---
        // NewsAPI.org の無料キー (開発用)。本番利用時は有料プランまたは他APIが必要です。
        const API_KEY = '97c630a00b7e4553930282624200710'; 
        const BASE_URL = 'https://newsapi.org/v2/top-headlines';
        
        // --- State ---
        let isPlaying = false;
        let synth = window.speechSynthesis;
        let voices = [];
        let selectedVoice = null;
        let newsQueue = [];
        let currentUtterance = null;
        let startTime = 0;
        let timerInterval = null;

        // --- Initialization ---
        document.addEventListener('DOMContentLoaded', () => {
            loadTheme();
            loadVoices();
            // Voices are loaded asynchronously in some browsers
            if (speechSynthesis.onvoiceschanged !== undefined) {
                speechSynthesis.onvoiceschanged = loadVoices;
            }
        });

        // --- Theme Logic ---
        function setTheme(theme) {
            localStorage.setItem('theme', theme);
            loadTheme();
        }

        function loadTheme() {
            const theme = localStorage.getItem('theme') || 'system';
            const html = document.documentElement;
            
            if (theme === 'dark') {
                html.classList.add('dark');
            } else if (theme === 'light') {
                html.classList.remove('dark');
            } else {
                // System
                if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    html.classList.add('dark');
                } else {
                    html.classList.remove('dark');
                }
            }
        }

        // --- Voice Logic ---
        function loadVoices() {
            voices = synth.getVoices().filter(v => v.lang.includes('ja'));
            console.log("Available Japanese voices:", voices.length);
        }

        function findBestVoice(gender, age) {
            if (voices.length === 0) return null;

            // Simple heuristic based on voice name and properties
            // Note: Browser voices vary wildly. This is a best-effort mapping.
            let candidates = voices;

            // Gender filtering (very approximate based on name)
            if (gender === 'female') {
                candidates = candidates.filter(v => /female|woman|girl|haruka|sayaka|misaki|natsuki|kyoko/i.test(v.name));
            } else {
                candidates = candidates.filter(v => /male|man|boy|ken|takeru|daigo|ichiro/i.test(v.name));
            }
            
            // If filtering by gender leaves no voices, reset
            if (candidates.length === 0) candidates = voices;

            // Age/Pitch filtering
            // Pitch range is typically 0 to 2. Default is 1.
            // Younger = Higher Pitch, Older = Lower Pitch
            let targetPitch = 1.0;
            const ageNum = parseInt(age);
            
            if (ageNum <= 20) targetPitch = 1.2 + (Math.random() * 0.3);
            else if (ageNum <= 40) targetPitch = 1.0 + (Math.random() * 0.2);
            else targetPitch = 0.8 + (Math.random() * 0.2);

            // Return the first candidate and apply pitch/rate adjustments later
            return {
                voice: candidates[0],
                pitch: targetPitch,
                rate: ageNum > 50 ? 0.9 : 1.0 // Older people speak slightly slower
            };
        }

        // --- App Logic ---
        function openSettings() {
            document.getElementById('settingsModal').classList.remove('hidden');
        }

        function saveSettings() {
            document.getElementById('settingsModal').classList.add('hidden');
            
            const gender = document.getElementById('voiceGender').value;
            const age = document.getElementById('voiceAge').value;
            const category = document.getElementById('newsCategory').value;
            
            const voiceConfig = findBestVoice(gender, age);
            selectedVoice = voiceConfig;

            const catNames = {
                'general': '総合ニュース', 'business': 'ビジネス', 'technology': 'テクノロジー',
                'entertainment': 'エンタメ', 'sports': 'スポーツ', 'science': 'サイエンス', 'health': 'ヘルス'
            };
            document.getElementById('currentCategoryDisplay').innerText = catNames[category] || 'ニュース';
            
            // Stop current if playing
            if(isPlaying) togglePlay();
        }

        async function fetchNews() {
            const category = document.getElementById('newsCategory').value;
            const country = 'jp';
            const url = `${BASE_URL}?country=${country}&category=${category}&apiKey=${API_KEY}&pageSize=10`;

            try {
                const response = await fetch(url);
                const data = await response.json();
                
                if (data.status === 'ok') {
                    return data.articles.filter(a => a.title && a.description);
                } else {
                    alert('ニュースの取得に失敗しました: ' + data.message);
                    return [];
                }
            } catch (error) {
                console.error(error);
                alert('ネットワークエラーが発生しました。');
                return [];
            }
        }

        async function refreshNews() {
            if (isPlaying) togglePlay();
            document.getElementById('statusText').innerText = "ニュース取得中...";
            newsQueue = await fetchNews();
            
            const transcriptArea = document.getElementById('transcriptArea');
            transcriptArea.innerHTML = ''; // Clear

            if (newsQueue.length > 0) {
                document.getElementById('statusText').innerText = "再生準備完了";
                // Preview first headline
                document.getElementById('currentHeadline').innerText = newsQueue[0].title;
            } else {
                document.getElementById('statusText').innerText = "ニュースがありません";
            }
        }

        function togglePlay() {
            if (isPlaying) {
                // Stop
                synth.cancel();
                isPlaying = false;
                document.getElementById('playBtn').innerHTML = '<i class="fas fa-play ml-1"></i>';
                document.getElementById('playBtn').classList.remove('bg-red-500');
                document.getElementById('playBtn').classList.add('bg-primary');
                document.body.classList.remove('speaking');
                clearInterval(timerInterval);
                document.getElementById('statusText').innerText = "一時停止";
            } else {
                // Start
                if (newsQueue.length === 0) {
                    refreshNews().then(() => {
                        if(newsQueue.length > 0) startPlayback();
                    });
                } else {
                    startPlayback();
                }
            }
        }

        function startPlayback() {
            if (!selectedVoice) {
                alert("まず設定画面で音声を選んでください");
                openSettings();
                return;
            }
            if (newsQueue.length === 0) return;

            isPlaying = true;
            startTime = Date.now();
            document.getElementById('playBtn').innerHTML = '<i class="fas fa-pause"></i>';
            document.getElementById('playBtn').classList.remove('bg-primary');
            document.getElementById('playBtn').classList.add('bg-red-500');
            document.body.classList.add('speaking');
            document.getElementById('statusText').innerText = "配信中";
            
            timerInterval = setInterval(updateTimer, 1000);
            
            speakNext();
        }

        function speakNext() {
            if (!isPlaying || newsQueue.length === 0) {
                if(newsQueue.length === 0 && isPlaying) {
                    // End of queue
                    togglePlay(); 
                    document.getElementById('statusText').innerText = "終了しました";
                }
                return;
            }

            const article = newsQueue.shift(); // Get next
            document.getElementById('currentHeadline').innerText = article.title;

            // Create Script
            // "次のニュースです。[Title]。[Description]" format
            const text = `次のニュースです。${article.title}。${article.description || ''}`;
            
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.voice = selectedVoice.voice;
            utterance.pitch = selectedVoice.pitch;
            utterance.rate = selectedVoice.rate;
            utterance.volume = 1;
            utterance.lang = 'ja-JP';

            // Add to transcript UI
            addTranscript(article.title, article.description);

            utterance.onend = () => {
                if (isPlaying) speakNext();
            };

            utterance.onerror = (e) => {
                console.error("Speech error", e);
                if (isPlaying) speakNext(); // Skip bad one
            };

            currentUtterance = utterance;
            synth.speak(utterance);
        }

        function addTranscript(title, desc) {
            const area = document.getElementById('transcriptArea');
            const div = document.createElement('div');
            div.className = "bg-gray-50 dark:bg-gray-800 p-3 rounded-lg border border-gray-100 dark:border-gray-700 animate-pulse-once";
            div.innerHTML = `
                <p class="font-bold text-primary text-sm mb-1">📰 ${title}</p>
                <p class="text-xs opacity-80">${desc || '...'}</p>
            `;
            area.prepend(div);
        }

        function updateTimer() {
            const delta = Math.floor((Date.now() - startTime) / 1000);
            const m = Math.floor(delta / 60).toString().padStart(2, '0');
            const s = (delta % 60).toString().padStart(2, '0');
            document.getElementById('timer').innerText = `${m}:${s}`;
            
            // Fake progress bar for visual
            const pct = (delta % 60) / 60 * 100;
            document.getElementById('progressBar').style.width = `${pct}%`;
        }

    </script>
</body>
</html>
